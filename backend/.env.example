# CHAKRAVYUH backend configuration — copy to .env and adjust.
# NEVER put real secrets here or in .env (which is git-ignored).

# --- Application ---
APP_NAME=CHAKRAVYUH
ENVIRONMENT=development            # development | production
DEBUG=false
LOG_LEVEL=INFO

# --- HTTP server ---
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list of allowed browser origins (frontend dev server). Keep restrictive.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- MongoDB ---
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=chakravyuh

# --- Sessions ---
# Required in production. In development a random secret is generated and stored
# in backend/.session_secret on first run if this is left empty.
SESSION_SECRET=
SESSION_TTL_MINUTES=720
REFRESH_TTL_DAYS=14
# auto = secure cookies only when ENVIRONMENT=production (requires HTTPS)
COOKIE_SECURE=auto
BCRYPT_ROUNDS=12

# --- Rate limiting (requests/minute) ---
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AI_PER_MIN=30

# --- AI provider (server-side only; never exposed to the browser) ---
# Supported: openai | openai_compatible | anthropic. Leave empty to disable the
# AI assistant (the app stays usable and reports that AI is not configured).
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=                       # required for openai_compatible; optional override otherwise
AI_MODEL=
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=1500

# --- Password-reset email (optional; standard SMTP) ---
# When unset, forgot-password honestly reports that no email was sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
