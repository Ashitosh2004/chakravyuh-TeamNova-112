    "outputSpec": "analogWrite(5, duty)",
    "examples": [
      {
        "input": "lux=450",
        "output": "duty=127"
      }
    ],
    "constraints": [
      "You may use map() and constrain()."
    ],
    "starter": "int duty = 0;\n// compute duty\n\nanalogWrite(5, duty);",
    "tests": [
