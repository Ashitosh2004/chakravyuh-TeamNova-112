[
  {
    "id": "xor-gate",
    "title": "Build XOR from basic operators",
    "category": "Boolean logic",
    "difficulty": "Beginner",
    "points": 10,
    "objective": "Express a logic gate using AND, OR and NOT.",
    "statement": "Return the XOR of inputs a and b using only &&, || and ! (do not use ^ or !=).",
    "inputSpec": "a, b ∈ {0, 1}",
    "outputSpec": "return 1 if exactly one input is 1, else 0",
    "examples": [
      {
        "input": "a=1, b=0",
        "output": "1"
      },
      {
        "input": "a=1, b=1",
        "output": "0"
      }
    ],
    "constraints": [
      "Use only &&, || and !"
    ],
    "starter": "// a and b are provided (0 or 1)\nint y = 0;\n// your logic here\n\nreturn y;",
    "tests": [
      {
        "name": "a=0, b=0",
        "inputs": {
          "a": 0,
          "b": 0
        },
        "expectReturn": 0
      },
      {
        "name": "a=0, b=1",
        "inputs": {
          "a": 0,
          "b": 1
        },
        "expectReturn": 1
      },
      {
        "name": "a=1, b=0",
        "inputs": {
          "a": 1,
          "b": 0
        },
        "expectReturn": 1
      },
      {
        "name": "a=1, b=1",
        "inputs": {
          "a": 1,
          "b": 1
        },
        "expectReturn": 0
      }
    ],
    "hint": "XOR = (a AND NOT b) OR (NOT a AND b)."
  },
  {
    "id": "binary-to-decimal",
    "title": "Binary digits to decimal",
    "category": "Number-system conversion",
    "difficulty": "Beginner",
    "points": 15,
    "objective": "Apply place-value weights.",
    "statement": "Four bits b3 b2 b1 b0 (b3 is the MSB) are provided. Return their decimal value.",
    "inputSpec": "b3, b2, b1, b0 ∈ {0, 1}",
    "outputSpec": "decimal value 0–15",
    "examples": [
      {
        "input": "b3=1 b2=0 b1=1 b0=1",
        "output": "11"
      }
    ],
    "constraints": [
      "Do not hard-code answers."
    ],
    "starter": "int value = 0;\n// combine the bits using powers of two\n\nreturn value;",
    "tests": [
      {
        "name": "0000",
        "inputs": {
          "b3": 0,
          "b2": 0,
          "b1": 0,
          "b0": 0
        },
        "expectReturn": 0
      },
      {
        "name": "1011",
        "inputs": {
          "b3": 1,
          "b2": 0,
          "b1": 1,
          "b0": 1
        },
        "expectReturn": 11
      },
      {
        "name": "1111",
        "inputs": {
          "b3": 1,
          "b2": 1,
          "b1": 1,
          "b0": 1
        },
        "expectReturn": 15
      },
      {
        "name": "0110",
        "inputs": {
          "b3": 0,
          "b2": 1,
          "b1": 1,
          "b0": 0
        },
        "expectReturn": 6
      },
      {
        "name": "1000",
        "inputs": {
          "b3": 1,
          "b2": 0,
          "b1": 0,
          "b0": 0
        },
        "expectReturn": 8
      }
    ],
    "hint": "value = b3*8 + b2*4 + b1*2 + b0, or use shifts: (b3 << 3) | …"
  },
  {
    "id": "count-ones",
    "title": "Count set bits",
    "category": "Loops",
    "difficulty": "Intermediate",
    "points": 20,
    "objective": "Use a loop and bitwise operators.",
    "statement": "Given an 8-bit number n, return how many bits are 1 (its population count). A parity checker uses this value.",
    "inputSpec": "0 ≤ n ≤ 255",
    "outputSpec": "number of 1 bits",
    "examples": [
      {
        "input": "n=5 (00000101)",
        "output": "2"
      },
      {
        "input": "n=255",
        "output": "8"
      }
    ],
    "constraints": [
      "Use a loop; maximum 8 iterations is enough."
    ],
    "starter": "int count = 0;\nfor (int i = 0; i < 8; i++) {\n  // check bit i\n}\nreturn count;",
    "tests": [
      {
        "name": "n=0",
        "inputs": {
          "n": 0
        },
        "expectReturn": 0
      },
      {
        "name": "n=5",
        "inputs": {
          "n": 5
        },
        "expectReturn": 2
      },
      {
        "name": "n=255",
        "inputs": {
          "n": 255
        },
        "expectReturn": 8
      },
      {
        "name": "n=128",
        "inputs": {
          "n": 128
        },
        "expectReturn": 1
      },
      {
        "name": "n=170",
        "inputs": {
          "n": 170
        },
        "expectReturn": 4
      },
      {
        "name": "n=77",
        "inputs": {
          "n": 77
        },
        "expectReturn": 4
      }
    ],
    "hint": "(n >> i) & 1 gives bit i."
  },
