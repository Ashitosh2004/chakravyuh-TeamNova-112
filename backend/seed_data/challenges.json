    "examples": [
      {
        "input": "temp=20, prev=1",
        "output": "1"
      },
      {
        "input": "temp=23, prev=1",
        "output": "0"
      }
    ],
    "constraints": [],
    "starter": "int state = prev;\n\nreturn state;",
    "tests": [
      {
        "name": "temp=17, prev=0",
        "inputs": {
          "temp": 17,
          "prev": 0
        },
        "expectReturn": 1
      },
      {
        "name": "temp=20, prev=1",
        "inputs": {
          "temp": 20,
          "prev": 1
        },
        "expectReturn": 1
      },
      {
        "name": "temp=20, prev=0",
        "inputs": {
          "temp": 20,
          "prev": 0
        },
        "expectReturn": 0
      },
      {
        "name": "temp=23, prev=1",
        "inputs": {
          "temp": 23,
          "prev": 1
        },
        "expectReturn": 0
      },
      {
        "name": "temp=18, prev=0",
        "inputs": {
          "temp": 18,
          "prev": 0
        },
        "expectReturn": 0
      },
      {
        "name": "temp=22, prev=1",
        "inputs": {
          "temp": 22,
          "prev": 1
        },
        "expectReturn": 1
      }
    ],
    "hint": "Two if branches; do nothing between 18 and 22 inclusive."
  },
