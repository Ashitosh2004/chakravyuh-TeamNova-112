        "name": "n=0",
        "inputs": {
          "n": 0
        },
        "expectReturn": 0
      },
      {
        "name": "n=1",
        "inputs": {
          "n": 1
        },
        "expectReturn": 1
      },
      {
        "name": "n=2",
        "inputs": {
          "n": 2
        },
        "expectReturn": 3
      },
      {
        "name": "n=3",
        "inputs": {
          "n": 3
        },
        "expectReturn": 2
      },
      {
