        "name": "lux=50",
        "inputs": {
          "lux": 50
        },
        "expectPins": {
          "5": 255
        }
      },
      {
        "name": "lux=100",
        "inputs": {
          "lux": 100
        },
        "expectPins": {
          "5": 255
        }
      },
      {
        "name": "lux=450",
        "inputs": {
          "lux": 450
        },
        "expectPins": {
          "5": 127
        }
      },
      {
        "name": "lux=800",
        "inputs": {
          "lux": 800
        },
        "expectPins": {
          "5": 0
        }
      },
      {
        "name": "lux=1000",
        "inputs": {
          "lux": 1000
        },
        "expectPins": {
          "5": 0
        }
      },
      {
        "name": "lux=275",
        "inputs": {
          "lux": 275
        },
        "expectPins": {
          "5": 191
        }
      }
