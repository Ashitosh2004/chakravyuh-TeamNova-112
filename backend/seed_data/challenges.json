  {
    "id": "snr-db",
    "title": "Signal-to-noise ratio in dB",
    "category": "Signal-processing calculations",
    "difficulty": "Intermediate",
    "points": 15,
    "objective": "Use logarithms for power ratios.",
    "statement": "Given signal power S and noise power N (watts), return the SNR in decibels.",
    "inputSpec": "S > 0, N > 0",
    "outputSpec": "10·log10(S/N)",
    "examples": [
      {
        "input": "S=100, N=1",
        "output": "20"
      }
    ],
    "constraints": [
      "Answer accepted within ±0.01 dB."
    ],
    "starter": "// log10() is available\nreturn 0;",
    "tests": [
      {
        "name": "S=100, N=1",
        "inputs": {
          "S": 100,
          "N": 1
        },
        "expectReturn": 20,
        "tolerance": 0.01
      },
      {
        "name": "S=1, N=1",
        "inputs": {
          "S": 1,
          "N": 1
        },
        "expectReturn": 0,
        "tolerance": 0.01
      },
      {
        "name": "S=2, N=1",
        "inputs": {
          "S": 2,
          "N": 1
        },
        "expectReturn": 3.010299956639812,
        "tolerance": 0.01
      },
      {
        "name": "S=0.5, N=0.005",
        "inputs": {
          "S": 0.5,
          "N": 0.005
        },
        "expectReturn": 20,
        "tolerance": 0.01
      }
    ],
    "hint": "return 10 * log10(S / N);"
  },
